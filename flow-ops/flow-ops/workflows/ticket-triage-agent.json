            "payload": "={{ JSON.stringify($json) }}",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "6076608e-f55b-3504-ea85-d53439325483",
      "name": "Dead Letter Queue",

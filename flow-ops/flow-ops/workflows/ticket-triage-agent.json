        640
      ],
      "credentials": {
        "postgres": {
          "id": "={{ $credentials.postgres }}",
          "name": "FlowOps Postgres"
        }
      },
      "notes": "Retries, because a dead-letter write that fails loses the item entirely.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {},
      "id": "756bd1e3-314a-5184-80c2-13cd71fac3c1",

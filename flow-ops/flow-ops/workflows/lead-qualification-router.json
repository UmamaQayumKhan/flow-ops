        "text": "=:fire: *Hot lead \u2014 {{ $json.score }}/100*\n{{ $('Normalise Lead').item.json.name }} \u00b7 {{ $('Normalise Lead').item.json.jobTitle }} @ {{ $('Normalise Lead').item.json.company }}\n{{ $('Normalise Lead').item.json.email }} \u00b7 team {{ $('Normalise Lead').item.json.teamSize }}\n*Owner* {{ $json.suggestedOwner }}\n_{{ $json.rationale }}_",
        "otherOptions": {}
      },
